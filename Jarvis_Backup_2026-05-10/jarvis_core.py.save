import wikipedia

def get_universal_data(query):
    # Ye function har cheez ka live data nikalega
    print(f"\033[1;34m[CORE]: Scanning global database for '{query}'...\033[0m")
    try:
        # Latest 2-3 lines ki jankari nikalna
        summary = wikipedia.summary(query, sentences=3)
        return summary
    except Exception:
        return f"Deepak Sir, '{query}' ki technical details abhi scan kar raha hoon. Kya main iska alternative dhoondun?"

import wikipedia
import requests

def universal_brain(query):
    # Ye function duniya ki kisi bhi company ya product ko scan karega
    print(f"\033[1;34m[SCANNING GLOBAL DATABASE]: {query}...\033[0m")
    
    # 1. Technical & General Knowledge (Wikipedia)
    try:
        wiki_data = wikipedia.summary(query, sentences=3)
    except:
        wiki_data = "Global database error. Searching alternative servers..."

    # 2. Company & Legal Check Logic [cite: 2026-01-18]
    # Yahan hum AI ko train kar rahe hain differentiate karne ke liye
    if "weapon" in query.lower() or "missile" in query.lower():
        status = "Defense Category - Analyzing International Traffic in Arms Regulations (ITAR)."
    elif "cosmetic" in query.lower() or "food" in query.lower():
        status = "Consumer Goods - Checking FDA and Global Standards."
    else:
        status = "General Industry - Scanning Market Presence."

    return f"Source: Global Network\nResult: {wiki_data}\nStatus: {status}"

